@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EStoreAdminModel.Brands;
@model CreateBrandModel;

<html>
<head>
    <title>Create Brand</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row mt-2">
            <div class="h1 text-center bg-primary-subtle">
                Create Brand
            </div>
        </div>

        <div class="col-lg-8 mx-auto rounder border p-3 mt-3">

            <form method="post" enctype="multipart/form-data">

                <div class="row">
                    <div class="col-sm-3 col-md-3 col-lg-3">
                        <label asp-for="Name">Brand Name</label>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                        <input type="text" asp-for="Name" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-sm-3 col-md-3 col-lg-3">
                        <a class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                    <div class="col-sm-4 col-md-4 col-lg-4">
                        <button class="btn btn-outline-primary"
                               asp-controller="Brand"
                                asp-action="CreateBrand">
                            Submit
                        </button>
                    </div>
                </div>
            </form>

        </div>

    </div>

  
</body>
</html>